# Copy to .env (git-ignored) and fill in. NEVER commit real values.
ANCHOR_DATABASE_URL=postgresql+psycopg2://anchor_user:CHANGE_ME@localhost:5432/anchor_dev
ANCHOR_API_TOKEN=CHANGE_ME_long_random_string
ANCHOR_PORT=8001
ANCHOR_TRUSTED_KEYS_DIR=anchor_service/trusted_keys
# test-only fault control; leave 0 outside experiments
ANCHOR_TEST_MODE=0
ANCHOR_TEST_TOKEN=CHANGE_ME_different_random_string
# optional telemetry for the anchor process
ANCHOR_RUN_ID=
ANCHOR_RAW_ROOT=
# destructive research operations are refused unless this is 1 AND the db is exactly hms_research
RESEARCH_MODE=0
